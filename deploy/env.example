# Шаблон .env для docker-compose.yml (chmod 600). Значения сейчас лежат в Railway → harvanera → web → Variables.

# ——— Контейнер ———
# Тег образа: latest | <короткий sha коммита> — закрепить или откатить
SITE_TAG=latest
# Порт на хосте (127.0.0.1), на него смотрит прокси
SITE_PORT=3070

# ——— Сайт ———
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://harvanera.com
# Сайт за Cloudflare: настоящий IP клиента — в CF-Connecting-IP (геоблокировка, журнал входов, заказы).
# Без Cloudflare, только свой nginx с proxy_set_header X-Real-IP — x-real-ip,x-forwarded-for
CLIENT_IP_HEADERS=cf-connecting-ip,x-real-ip,x-forwarded-for

# ——— Шлюз ———
DEEPINFRA_API_KEYS=
# TOGETHER_API_KEYS=
# GATEWAY_RPM=60

# ——— Почта (SMTP сервера компании) ———
EMAIL_HOST=mail.harvanera.com
EMAIL_PORT=587
EMAIL_USER=info@harvanera.com
EMAIL_PASS=
EMAIL_FROM=Harvanera <info@harvanera.com>
EMAIL_TLS_REJECT_UNAUTHORIZED=false

# ——— Геоблокировка ———
# GEO_BYPASS_TOKEN=
