# Скопировать в .env.local и заполнить.

# Секрет для подписи cookie сессий: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Публичный адрес сайта. В dev можно не задавать — берётся из запроса. Для OAuth и в production обязателен.
# BETTER_AUTH_URL=http://localhost:3000

# Путь к файлу SQLite (по умолчанию ./data/app.db)
# DATABASE_PATH=

# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Пока ключей нет, кнопка Google имитирует вход (демо-аккаунт).
# Вне production включено по умолчанию; в production — только с true.
# AUTH_DEMO_OAUTH=true

# ——— Шлюз /v1 (src/lib/gateway) ———
# Ключи хостеров открытых моделей, несколько через запятую — пул с переключением.
# Порядок хостеров для каждой модели — src/lib/gateway/routes.ts.
DEEPINFRA_API_KEYS=
TOGETHER_API_KEYS=
FIREWORKS_API_KEYS=
# Переопределить адрес хостера (egress-прокси, тестовый стенд): DEEPINFRA_BASE_URL=…
# Пока ключей нет, шлюз отвечает мок-ответами и честно списывает баланс.
# Вне production включено по умолчанию; в production — только с true.
# GATEWAY_MOCK=true
# Запросов в минуту на один клиентский ключ (по умолчанию 60)
# GATEWAY_RPM=60

# Демо-оплата: кнопка «Отметить оплаченным» на странице заказа, пока нет провайдера.
# Вне production включена по умолчанию; в production — только с true.
# PAYMENTS_DEMO=true
