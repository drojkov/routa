# Скопировать в .env.local и заполнить.

# Секрет для подписи cookie сессий: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Публичный адрес сайта. В dev можно не задавать — берётся из запроса. Для OAuth и в production обязателен.
# BETTER_AUTH_URL=http://localhost:3000

# Путь к файлу SQLite (по умолчанию ./data/app.db)
# DATABASE_PATH=

# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Яндекс ID: oauth.yandex.ru → Создать приложение → Веб-сервисы
# Redirect URI: http://localhost:3000/api/auth/callback/yandex
# Доступы: login:email, login:info, login:avatar
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Пока ключей нет, кнопки Google/Яндекс имитируют вход (демо-аккаунт).
# Вне production включено по умолчанию; в production — только с true.
# AUTH_DEMO_OAUTH=true
