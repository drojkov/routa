# Шаблон .env для docker-compose.yml (chmod 600). Боевые значения — в .env на сервере или в CI/CD-переменной ENV_FILE (у девопса).

# ——— Контейнер ———
# Образ: CI сам дописывает HARVANERA_IMAGE и SITE_TAG (короткий sha) при каждом деплое
# SITE_TAG=latest
# Домен для роутера Traefik (обязателен); www.SITE_HOST редиректится на него
SITE_HOST=harvanera.com

# ——— Сайт ———
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://harvanera.com
# IP клиента: X-Real-IP от Traefik; если это Cloudflare — берётся CF-Connecting-IP (lib/geo.ts). Задавать не нужно.
# CLIENT_IP_HEADERS=x-real-ip,x-forwarded-for

# ——— Шлюз ———
DEEPINFRA_API_KEYS=
# TOGETHER_API_KEYS=
# GATEWAY_RPM=60

# ——— Почта (SMTP сервера компании) ———
# изнутри сервера витрин mail.harvanera.com недоступен (NAT) — нужен внутренний адрес почтового сервера
EMAIL_HOST=mail.harvanera.com
EMAIL_PORT=587
EMAIL_USER=info@harvanera.com
EMAIL_PASS=
EMAIL_FROM=Harvanera <info@harvanera.com>
EMAIL_TLS_REJECT_UNAUTHORIZED=false

# ——— Геоблокировка ———
# GEO_BYPASS_TOKEN=
